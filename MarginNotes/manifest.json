{
  "manifest_version": 3,
  "name": "MarginNotes",
  "version": "1.0.0",
  "description": "Сохраняет выделенный текст с контекстом в карточки.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
